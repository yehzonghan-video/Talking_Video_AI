# 複製為 secrets.toml，填入自己的金鑰；secrets.toml 已列入 .gitignore。
GEMINI_API_KEY = ""
# 順序就是允許的主要及備用模型清單，不會自動新增清單外模型。
GEMINI_MODELS = ["gemini-3.6-flash", "gemini-3.5-flash-lite", "gemini-3.1-flash-lite"]
# 每個模型503最多重試2次（加上初次，共3次）；SDK內層重試已停用。
GEMINI_MAX_RETRIES = 2
GEMINI_RETRY_INITIAL_DELAY = 1.0
GEMINI_RETRY_MAX_DELAY = 8.0
GEMINI_REQUEST_TIMEOUT = 60.0
GEMINI_MAX_ELAPSED = 180.0
